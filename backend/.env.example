# Which provider to use. Defaults to gemini since it has a real ongoing free
# tier — no card, no expiration. Set to "anthropic" if you have Anthropic credits.
LLM_PROVIDER=gemini

# --- Gemini (free) ---
# Get a free key at https://aistudio.google.com/apikey (no card required)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (optional backup) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Groq (optional backup) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- NVIDIA NIM (optional backup) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# SQLite by default so it runs with zero setup. Swap to a real
# Postgres URL when you're ready, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/manO
DATABASE_URL=sqlite:///./manO.db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# --- Twilio Voice Call Service ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=http://localhost:8000
TWILIO_TWIML_URL=https://handler.twilio.com/twiml/EHc96398090a3969120e038fab22b4e16e

# --- Live SMTP Email Delivery (Gmail / Custom SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

TWILIO_VOICE=Polly.Matthew
TWILIO_VOICE_LANG=en-US
