# Which provider to use. Defaults to gemini since it has a real ongoing free
# tier — no card, no expiration. Set to "anthropic" if you have Anthropic credits.
LLM_PROVIDER=gemini

# --- Gemini (free) ---
# Get a free key at https://aistudio.google.com/apikey (no card required)
GEMINI_API_KEY=AQ.Ab8RN6LtaMXtIXeKd8_ELCgb1ZBPkbsbhuKKBbyvxhHvql5r5Q
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic (paid, no ongoing free tier — only used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite by default so it runs with zero setup. Swap to a real
# Postgres URL when you're ready, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/manO
DATABASE_URL=sqlite:///./manO.db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
